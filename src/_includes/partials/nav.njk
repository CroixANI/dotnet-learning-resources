{% set t = i18n[locale] %}
{% if locale == "ru" %}
  {% set topicsCollection = collections.topics_ru %}
  {% set langSwitchHref = "/en/" | url %}
{% else %}
  {% set topicsCollection = collections.topics_en %}
  {% set langSwitchHref = "/ru/" | url %}
{% endif %}

<nav id="sideNav" aria-label="{{ t['nav.label'] }}">
  <div class="site-nav-header">
    <span class="site-title">{{ site.name }}</span>
    <button id="nav-toggle" class="nav-toggle"
      aria-label="{{ t['nav.toggle'] }}"
      aria-expanded="false"
      aria-controls="navbarSupportedContent">&#9776;</button>
  </div>

  <div id="navbarSupportedContent" class="nav-collapse">
    <ul id="main-navigation" class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" href="{{ ('/' + locale + '/') | url }}">{{ t["nav.home"] }}</a>
      </li>
      {% for topic in topicsCollection %}
        <li class="nav-item">
          <a class="nav-link" href="{{ ('/' + locale + '/') | url }}#{{ topic.data.topicId }}">
            {{ loop.index }}. {{ topic.templateContent | extractH1Text }}
          </a>
        </li>
      {% endfor %}
      <li class="nav-item">
        <a class="nav-link" href="{{ ('/' + locale + '/questions/') | url }}">{{ t["nav.questions"] }}</a>
      </li>
    </ul>

    <div class="sidebar-footer">
      <a href="{{ langSwitchHref }}" class="lang-switch" aria-label="{{ t['nav.lang_switch_label'] }}">
        {{ t["nav.lang_switch"] }}
      </a>
      <button id="theme-toggle" aria-label="{{ t['theme.toggle'] }}">◐</button>
    </div>
  </div>
</nav>
